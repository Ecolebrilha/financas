# Postgres — local e produção usam o mesmo banco (ex: Neon, plano free)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

PORT=3001

# Opcional: se definida, toda a API passa a exigir esse valor no header
# "Authorization: Bearer <senha>". Deixe em branco/comentado em dev local
# pra não precisar de senha; configure em produção pra proteger o acesso.
# APP_PASSWORD="escolha-uma-senha-forte"
